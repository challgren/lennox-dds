// ============================================================================
// lennox_m30.idl  --  Recovered OpenDDS data model for the Lennox iComfort M30
// ============================================================================
//
// Reverse-engineered (static analysis only) from the decompiled S40 homeowner
// Android app (com.lennox.s40.homeowner). The DDS types were generated by
// OpenDDS `idl2jni`, so each decompiled Java class maps 1:1 to an IDL construct.
//
// Field ORDER below is the CDR/wire order taken from each generated class's
// CONSTRUCTOR argument order (jadx sorts *fields* alphabetically, so the field
// declaration order in the .java is NOT the wire order -- the constructor is).
//
// The "valid field" pattern is NOT a per-field wrapper struct. It is a single
// bitmask integer `validFlag` on each struct; every `<Struct>_Valid_<Field>`
// Java interface is just a bit-value constant (power of two) telling you which
// bit of `validFlag` marks that field present. Those constants are reproduced
// here as IDL `const unsigned long`.
//
// Enum values are the exact `_k...` integer constants from the *Enum.java.
// Type repository ids are of the form  IDL:<Module>/<type>:1.0 .
//
// Anything marked "// TODO confirm" could not be fully verified from static
// analysis. See TOPICS.md for per-finding source-file citations.
// ============================================================================

// ---------------------------------------------------------------------------
// Lx_PeriodIDL  --  a schedule/override period; also embedded in zoneStatus
// topic literal (TOPIC_ZONE_PERIOD) = "Period"
// ---------------------------------------------------------------------------
module Lx_PeriodIDL {

    enum systemModeEnum {
        kSystemModeOff,          // 0
        kSystemModeHeat,         // 1
        kSystemModeCool,         // 2
        kSystemModeHeatAndCool,  // 3
        kSystemModeEmergencyHeat,// 4
        kSystemModeRsvd5,        // 5
        kSystemModeRsvd6,        // 6
        kSystemModeRsvd7,        // 7
        kSystemModeError         // 8
    };

    enum fanmodeEnum {
        kFanModeRsvd0,           // 0
        kFanModeAuto,            // 1
        kFanModeCirculate,       // 2
        kFanModeOn,              // 3
        kFanModeAutoCirculate,   // 4
        kFanModeError            // 5
    };

    enum humidityModeEnum {
        kHumidityModeOff,        // 0
        kHumidityModeHumidify,   // 1
        kHumidityModeDehumidify, // 2
        kHumidityModeBoth,       // 3
        kHumidityModeError       // 4
    };

    // validFlag bit constants (Period_Valid_*)
    const unsigned long Period_Valid_ID          = 1;
    const unsigned long Period_Valid_Enabled     = 2;
    const unsigned long Period_Valid_StartTime   = 4;
    const unsigned long Period_Valid_SystemMode  = 8;
    const unsigned long Period_Valid_Hsp         = 16;
    const unsigned long Period_Valid_HspC        = 32;
    const unsigned long Period_Valid_Csp         = 64;
    const unsigned long Period_Valid_CspC        = 128;
    const unsigned long Period_Valid_Sp          = 256;
    const unsigned long Period_Valid_SpC         = 512;
    const unsigned long Period_Valid_Away        = 1024;
    const unsigned long Period_Valid_HumidityMode= 2048;
    const unsigned long Period_Valid_Husp        = 4096;
    const unsigned long Period_Valid_Desp        = 8192;
    const unsigned long Period_Valid_FanMode     = 16384;
    const unsigned long Period_Valid_HspChanged  = 32768;
    const unsigned long Period_Valid_CspChanged  = 65536;

    @autoid(HASH) @mutable
    struct period {
        unsigned long    id;            // wire pos 0 (device: uint32)
        boolean          enabled;       //          1
        unsigned long    startTime;     //          2  (minutes from midnight, uint32)
        systemModeEnum   systemMode;    //          3
        double           hsp;           //          4  heat setpoint (F)
        double           hspC;          //          5  heat setpoint (C)
        double           csp;           //          6  cool setpoint (F)
        double           cspC;          //          7  cool setpoint (C)
        double           sp;            //          8  single setpoint (F)
        double           spC;           //          9  single setpoint (C)
        boolean          away;          //         10
        humidityModeEnum humidityMode;  //         11
        double           husp;          //         12  humidify setpoint
        double           desp;          //         13  dehumidify setpoint
        fanmodeEnum      fanMode;       //         14
        boolean          isHspChanged;  //         15
        boolean          isCspChanged;  //         16
        unsigned long    validFlag;     //         17  (bitmask, see above)
    };
};

// ---------------------------------------------------------------------------
// LxZoneStatusIDL  --  live per-zone telemetry
// topic literal (TOPIC_ZONE_STATUS) = "LCC Zone Status"
// ---------------------------------------------------------------------------
module LxZoneStatusIDL {

    enum temperatureStatusEnum {
        kTempStatusGood,          // 0
        kTempStatusNot_available, // 1
        kTempStatusError          // 2
    };

    enum humidityStatusEnum {
        kHumStatusGood,           // 0
        kHumStatusNot_available,  // 1
        kHumStatusError           // 2
    };

    enum tempOperationEnum {
        kTempOperationOff,        // 0
        kTempOperationHeating,    // 1
        kTempOperationCooling,    // 2
        kTempOperationWaiting,    // 3
        kTempOperationError       // 4
    };

    enum humidityOperationEnum {
        kHumOperationOff,          // 0
        kHumOperationHhumidifying, // 1  (sic, double 'h' in source)
        kHumOperationDehumidifying,// 2
        kHumOperationWaiting,      // 3
        kHumOperationError         // 4
    };

    enum balancePointEnum {
        kBalancepointNone,        // 0
        kBalancepointHigh,        // 1
        kBalancepointMid,         // 2
        kBalancepointLow,         // 3
        kBalancepointError        // 4
    };

    // Simple id pair embedded in zoneStatus.scheduleExceptionIds.
    // (distinct from LxScheduleExceptionIDL::scheduleException below)
    @autoid(HASH) @mutable
    struct scheduleException {
        unsigned long id;         // device: uint32
        unsigned long scheduleId; // device: uint32
    };
    typedef sequence<scheduleException> scheduleExceptionSeq;

    // validFlag bit constants (ZoneStatus_Valid_*)
    const unsigned long ZoneStatus_Valid_Temp             = 1;
    const unsigned long ZoneStatus_Valid_TempC            = 2;
    const unsigned long ZoneStatus_Valid_TempStatus       = 4;
    const unsigned long ZoneStatus_Valid_Humidity         = 8;
    const unsigned long ZoneStatus_Valid_HumStatus        = 16;
    const unsigned long ZoneStatus_Valid_TempOperation    = 32;
    const unsigned long ZoneStatus_Valid_HumOperation     = 64;
    const unsigned long ZoneStatus_Valid_FanStatus        = 128;
    const unsigned long ZoneStatus_Valid_AllergenDefender = 256;
    const unsigned long ZoneStatus_Valid_Ventilation      = 512;
    const unsigned long ZoneStatus_Valid_Aux              = 1024;
    const unsigned long ZoneStatus_Valid_SSR              = 2048;
    const unsigned long ZoneStatus_Valid_Defrost          = 4096;
    const unsigned long ZoneStatus_Valid_HeatCoast        = 8192;
    const unsigned long ZoneStatus_Valid_CoolCoast        = 16384;
    const unsigned long ZoneStatus_Valid_Period           = 32768;
    const unsigned long ZoneStatus_Valid_ExceptionId      = 65536;
    const unsigned long ZoneStatus_Valid_Balancepoint     = 131072;
    const unsigned long ZoneStatus_Valid_Bleeding         = 262144;

    @autoid(HASH) @mutable @nested(FALSE)
    struct zoneStatus {
        @key unsigned long      zoneId;             // wire pos 0 (device: uint32, KEY)
        @key string             sysID;              //          1 (KEY)
        double                  temperature;        //          2  (F)
        double                  temperatureC;       //          3  (C)
        temperatureStatusEnum   tempStatus;         //          4
        double                  humidity;           //          5  (%)
        humidityStatusEnum      humidityStatus;     //          6
        tempOperationEnum       tempOperation;      //          7
        humidityOperationEnum   humOperation;       //          8
        boolean                 fan;                //          9
        boolean                 allergenDefender;   //         10
        boolean                 ventilation;        //         11
        boolean                 aux;                //         12
        boolean                 ssr;                //         13
        boolean                 defrost;            //         14
        boolean                 heatCoast;          //         15
        boolean                 coolCoast;          //         16
        Lx_PeriodIDL::period    period;             //         17  (active period)
        scheduleExceptionSeq    scheduleExceptionIds; //       18
        balancePointEnum        balancePoint;       //         19
        unsigned long           validFlag;          //         20  (bitmask)
    };
    // NOTE: no `damper` field in the DDS struct; the app hard-codes damper=0.0
    //       (t8/m0.java line ~216).  "demand"/"tempOperation" == tempOperation.
};

// ---------------------------------------------------------------------------
// LxSchedulesIDL   --  a schedule (array of periods)
// topic literal (TOPIC_SCHEDULES) = "Schedules"   (nested type; see below)
// The schedule struct is transported inside scheduleList / scheduleUpdate.
// ---------------------------------------------------------------------------
module LxSchedulesIDL {

    typedef sequence<Lx_PeriodIDL::period> periodSeq;

    const unsigned long Schedule_Valid_Name        = 1;
    const unsigned long Schedule_Valid_Periods     = 2;
    const unsigned long Schedule_Valid_Periodcount = 4;

    @autoid(HASH) @mutable
    struct schedule {
        string        name;         // wire pos 0
        periodSeq     periods;      //          1
        unsigned long periodCount;  //          2 (device: uint32)
        unsigned long validFlag;    //          3  (bitmask)
    };
};

// ---------------------------------------------------------------------------
// LxScheduleListIDL  --  read topic that carries a schedule for a scheduleId
// topic literal (TOPIC_SCHEDULES_LIST) = "LCC Schedule List"
// ---------------------------------------------------------------------------
module LxScheduleListIDL {
    const unsigned long ScheduleList_Valid_Schedule = 1;

    struct scheduleList {
        long                    scheduleId;  // wire pos 0
        string                  sysID;       //          1
        LxSchedulesIDL::schedule schedule;   //          2
        unsigned long           validFlag;   //          3
    };
};

// ---------------------------------------------------------------------------
// LxScheduleUpdateIDL  --  write topic to push a schedule (control)
// topic literal (TOPIC_SCHEDULE_UPDATE) = "Owner Schedule Update"
// ---------------------------------------------------------------------------
module LxScheduleUpdateIDL {
    const unsigned long ScheduleUpdate_Valid_Schedule = 1;

    @autoid(HASH) @mutable @nested(FALSE)
    struct scheduleUpdate {
        @key unsigned long      scheduleId;  // wire pos 0 (device: uint32, KEY)
        string                  sysID;       //          1
        LxSchedulesIDL::schedule schedule;   //          2
        unsigned long           validFlag;   //          3
    };
};

// ---------------------------------------------------------------------------
// LxScheduleExceptionIDL  --  schedule override/exception (hold) definition
// topic literal (TOPIC_SCHEDULE_EXCEPTION) present
// ---------------------------------------------------------------------------
module LxScheduleExceptionIDL {
    // exceptionTypeEnum / expirationModeEnum values // TODO confirm exact ints
    enum exceptionTypeEnum { kExceptionType0 };   // TODO confirm
    enum expirationModeEnum { kExpirationMode0 };  // TODO confirm

    const unsigned long ScheduleException_Valid_ScheduleId    = 1; // TODO confirm bit map
    const unsigned long ScheduleException_Valid_Enabled       = 2; // TODO confirm
    const unsigned long ScheduleException_Valid_ExceptionType = 4; // TODO confirm
    const unsigned long ScheduleException_Valid_ExpirationMode= 8; // TODO confirm
    const unsigned long ScheduleException_Valid_ExpiresOn     = 16;// TODO confirm

    struct scheduleException {
        long               scheduleId;      // field order TODO confirm (jadx-sorted)
        boolean            enabled;
        exceptionTypeEnum  exceptionType;
        expirationModeEnum expirationMode;
        string             expiresOn;
        unsigned long      validFlag;
    };
};

// ---------------------------------------------------------------------------
// Lx_SystemParametersIDL  --  system-wide config parameters (embedded in
// systemConfigStatus.configStatus). Only the fields the app reads are named.
// ---------------------------------------------------------------------------
module Lx_SystemParametersIDL {

    enum temperatureUnitEnum {
        kTempUnitC,   // 0
        kTempUnitF    // 1
    };

    enum scheduleHoldPropertyEnum {
        kScheduleHoldPrptytwoHour,    // 0
        kScheduleHoldPrptyfourHour,   // 1
        kScheduleHoldPrptynextPeriod, // 2
        kScheduleHoldPrptynextError   // 3
    };

    // referenced but not fully enumerated here // TODO confirm enum ints
    enum languageEnum          { kLanguage0 };            // TODO confirm
    enum humidificationModeEnum{ kHumidificationMode0 };  // TODO confirm
    enum dehumidificationModeEnum { kDehumidificationMode0 }; // TODO confirm
    enum ventilationModeEnum   { kVentilationMode0 };     // TODO confirm

    struct params {
        temperatureUnitEnum       temperatureUnit;                    // wire 0
        languageEnum              language;                           //      1
        boolean                   allergenDefender;                   //      2
        double                    circulateTime;                      //      3
        humidificationModeEnum    humMode;                            //      4
        dehumidificationModeEnum  dehumMode;                          //      5
        string                    systemName;                         //      6
        ventilationModeEnum       ventilationMode;                    //      7
        double                    enhancedDehumidificationOvercoolingF;//     8
        double                    enhancedDehumidificationOvercoolingC;//     9
        scheduleHoldPropertyEnum  scheduleHoldProperty;               //     10
        unsigned long             validFlag;                          //     11
    };
};

// ---------------------------------------------------------------------------
// Lx_SystemConfigStatusIDL  --  system name / central mode / reconfig stamp
// topic literal (TOPIC_SYSTEM_CONFIG_STATUS) = "LCC System Config Status"
// ---------------------------------------------------------------------------
module Lx_SystemConfigStatusIDL {
    const unsigned long SysConfigStatus_Valid_Status               = 1;
    const unsigned long SysConfigStatus_Valid_HVACReconfigTimeStamp= 2;
    const unsigned long SysConfigStatus_Valid_CentralMode          = 4;

    struct systemConfigStatus {
        string                        sysID;         // wire pos 0
        Lx_SystemParametersIDL::params configStatus; //          1
        unsigned long                 validFlag;     //          2
        string                        reconfigTstamp;//          3
        boolean                       centralMode;   //          4
    };
};

// ---------------------------------------------------------------------------
// LxCommandUpdateIDL  --  CONTROL: owner command write topic
// topic literal (TOPIC_COMMAND_UPDATE) = "Owner Command Update"
// ---------------------------------------------------------------------------
module LxCommandUpdateIDL {

    enum commandTypeEnum {
        kCommandZones,               // 0
        kCommandSystemController,     // 1
        kCommandResetSingleSchedule,  // 2
        kCommandError                 // 3
    };

    const unsigned long CommandUpdate_Valid_Data_ZoneId      = 1;
    const unsigned long CommandUpdate_Valid_Data_Command     = 2;
    const unsigned long CommandUpdate_Valid_Data_CommandType = 4;
    const unsigned long CommandUpdate_Valid_Data_ScheduleId  = 8;

    struct commandUpdate {
        string          sysID;        // wire pos 0
        long            zoneId;       //          1
        string          command;      //          2  (JSON/command payload)
        commandTypeEnum commandType;  //          3
        long            scheduleId;   //          4
        unsigned long   validFlag;    //          5  (bitmask)
    };
};

// ---------------------------------------------------------------------------
// LxDevicesIDL  --  equipment devices, their features and parameters
// topic literal (TOPIC_DEVICES) = "LCC Devices"
// ---------------------------------------------------------------------------
module LxDevicesIDL {

    enum devFormatEnum {
        kFormatEnum,      // 0
        kFormatBool8,     // 1
        kFormatBool16,    // 2
        kFormatUint4,     // 3
        kFormatUint8,     // 4
        kFormatInt8,      // 5
        kFormatUint16,    // 6
        kFormatInt16,     // 7
        kFormatUint32,    // 8
        kFormatInt32,     // 9
        kFormatNts,       // 10
        kFormat16q4,      // 11
        kFormat16q8,      // 12
        kFormatU16q4,     // 13
        kFormatU16q8,     // 14
        kFormat32q4,      // 15
        kFormat32q8,      // 16
        kFormat32q16,     // 17
        kFormatU32q4,     // 18
        kFormatU32q8,     // 19
        kFormatU32q16,    // 20
        kFormat0p5,       // 21
        kFormat0_5,       // 22
        kFormatTime,      // 23
        kFormatDate,      // 24
        kFormatTzone,     // 25
        kFormatTstamp,    // 26
        kFormatArray,     // 27
        kFormatStr_array, // 28
        kFormatLanguage,  // 29
        kFormat6bchar,    // 30
        kFormat12h_ts,    // 31
        kFormatTid,       // 32
        kFormatBool,      // 33
        kFormatUint2,     // 34
        kFormatUint3,     // 35
        kFormatPwd,       // 36
        kFormatError      // 37
    };

    enum devParamDescriptorEnum {
        kDescriptorUndef,     // 0
        kDescriptorRange,     // 1
        kDescriptorRadio,     // 2
        kDescriptorDescString,// 3
        kDescriptorBool,      // 4
        kDescriptorError      // 5
    };

    // --- device feature ---
    struct Values {
        long   id;      // TODO confirm order (jadx-sorted, 2 fields)
        string value;
    };
    typedef sequence<Values> featureValueSeq;

    const unsigned long DevFeature_Valid_Fid         = 1;
    const unsigned long DevFeature_Valid_FeatureName = 2;
    const unsigned long DevFeature_Valid_Format      = 4;
    const unsigned long DevFeature_Valid_Unit        = 8;

    struct deviceFeature {
        long            fid;          // wire pos 0
        string          featureName;  //          1
        devFormatEnum   format;       //          2
        string          unit;         //          3
        featureValueSeq valuesList;   //          4
        unsigned long   validFlag;    //          5
    };
    typedef sequence<deviceFeature> deviceFeatureSeq;

    // --- device parameter (union-typed descriptor) ---
    struct devParamItem {
        long   id;    // TODO confirm order (jadx-sorted, 2 fields)
        string text;
    };
    typedef sequence<devParamItem> textSeq;

    struct devParamRange  { string min; string max; string inc; }; // TODO confirm order
    struct devParamRadio  { string max; textSeq texts; };          // TODO confirm order
    struct devParamString { string max; };
    struct devParamBool   { boolean enabled; };

    union devParamType switch (devParamDescriptorEnum) {
        case kDescriptorRange:      devParamRange  paramRange;
        case kDescriptorRadio:      devParamRadio  paramRadio;
        case kDescriptorDescString: devParamString maxStrLength;
        case kDescriptorBool:       devParamBool   paramBool;
        // default (kDescriptorUndef/Error): empty
    };

    const unsigned long DevParameter_Valid_Pid          = 1;
    const unsigned long DevParameter_Valid_Enabled      = 2;
    const unsigned long DevParameter_Valid_Name         = 4;
    const unsigned long DevParameter_Valid_Value        = 8;
    const unsigned long DevParameter_Valid_DefaultValue = 16;
    const unsigned long DevParameter_Valid_Unit         = 32;
    const unsigned long DevParameter_Valid_Format       = 64;
    const unsigned long DevParameter_Valid_ParamType    = 128;

    struct deviceParameter {
        long          pid;          // wire pos 0
        boolean       enabled;      //          1
        string        name;         //          2
        string        value;        //          3
        string        defaultValue; //          4
        string        unit;         //          5
        devFormatEnum format;       //          6
        devParamType  paramType;    //          7
        unsigned long validFlag;    //          8
    };
    typedef sequence<deviceParameter> deviceParamSeq;

    // --- device ---
    const unsigned long Device_Valid_DeviceType = 1;
    const unsigned long Device_Valid_Features   = 2;
    const unsigned long Device_Valid_Params     = 4;

    struct device {
        long             id;          // wire pos 0
        string           sysID;       //          1
        long             deviceType;  //          2
        deviceFeatureSeq features;    //          3
        deviceParamSeq   parameters;  //          4
        unsigned long    validFlag;   //          5
    };
};
